# Salin ke .env di server, lalu isi semua nilai bertanda GANTI.
#
#   cp .env.production.example .env
#   docker compose -f compose.prod.yaml run --rm app php artisan key:generate --force
#
# Jangan pernah commit .env yang sudah terisi.

APP_NAME="Hypersonic Speed Tech"
APP_ENV=production
APP_KEY=                          # diisi oleh `php artisan key:generate`
APP_DEBUG=false
APP_URL=https://shop.garagehs-speed.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Port yang didengar container web di localhost VPS.
# Reverse proxy host meneruskan domain ke sini.
WEB_PORT=8090

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=knalpot
DB_USERNAME=knalpot
DB_PASSWORD=                      # GANTI — password kuat, bukan "secret"
DB_ROOT_PASSWORD=                 # GANTI — beda dari DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true karena situs dilayani lewat HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Boost menyuntikkan script browser-logger ke tiap halaman; jangan pernah
# dinyalakan di produksi.
BOOST_BROWSER_LOGS_WATCHER=false

# Email — isi dengan SMTP asli agar reset password berfungsi.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@garagehs-speed.com"
MAIL_FROM_NAME="${APP_NAME}"

# Kontak situs (bisa juga diubah lewat menu Website → Site settings).
SITE_EMAIL=hypersonicspeedtech@gmail.com
SITE_PHONE=62895337161221
SITE_WA_PRIMARY=62895337161221
SITE_WA_SALES_1=
SITE_WA_SALES_2=
SITE_WA_SALES_3=
